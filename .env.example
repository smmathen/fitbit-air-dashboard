# Copy to .env and fill in YOUR OAuth client ID from Google Cloud Console.
# Never commit .env — it is gitignored.
#
# Only the public client ID belongs here. Do NOT add a client secret or any
# VITE_* secret — Vite exposes VITE_ variables to the browser bundle.

VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE.apps.googleusercontent.com
